# Modèle du fichier .env : copier en .env et remplir.
# Lu par Django (dj_asbl/settings.py) et par docker compose (compose.yml).

# --- Django -------------------------------------------------------------------

# Clé secrète, longue et aléatoire. Pour en générer une :
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# False en production. Sans ce réglage, Django démarre en mode DEBUG, sauf sous
# docker compose où la valeur par défaut est False.
DEBUG=False

# Noms de domaine servis, séparés par des virgules.
DJANGO_ALLOWED_HOSTS=manager.example.be
# Origines de confiance pour les formulaires (schéma compris), séparées par des virgules.
CSRF_TRUSTED_ORIGINS=https://manager.example.be

# --- Base de données (PostgreSQL) ----------------------------------------------

POSTGRES_DB=dj_asbl
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
# Hôte et port vus depuis l'hôte (développement avec uv). Sous docker compose,
# web et cron utilisent toujours le service db sur le port 5432.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Email (serveur SMTP) ------------------------------------------------------

SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USE_TLS=False
SMTP_USE_SSL=False
SMTP_USER=
SMTP_PASSWORD=
# Adresse d'expédition des emails.
DEFAULT_FROM_EMAIL=asbl@example.be

# --- Nettoyage ponctuel -------------------------------------------------------

# True affiche, dans les visiteurs, le filtre et l'action de fusion des doublons
# hérités de l'ancienne application (naissance au 1er janvier). À remettre à
# False une fois le nettoyage fait.
VIALE_FUSION_1ER_JANVIER=False

# --- Docker compose ------------------------------------------------------------

# Port de l'hôte sur lequel web est publié.
PORT=8000

# --- Hors .env -----------------------------------------------------------------
# Réglés dans l'admin (/admin/, Constance), pas ici : VIALE_EMAIL,
# VIALE_TELEPHONE, VIALE_ADRESSE, REPLY_TO_EMAIL, SECRETAIRE_ID, PRESIDENT_ID.
# Paramètres des scripts, à passer en ligne de commande :
#   import_viale_dump.sh : COMPOSE (défaut « docker compose »)
#   extract_dump.sh      : CONTAINER, DB_USER, DB_NAME (base de l'ancien viale-manager)
